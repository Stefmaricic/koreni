# Copy this file to .env.local and fill in your Supabase project's values.
# Find them in the Supabase dashboard: Project Settings -> API.

# Project URL, e.g. https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_URL=

# The "anon" / "public" key (safe to expose in the browser — Row Level
# Security policies are what actually protect the data).
# NEVER put the "service_role" key in this file or anywhere in the frontend.
VITE_SUPABASE_ANON_KEY=
